{
  "name": "monthly-report-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-form": "latest",
    "@tanstack/react-router": "latest",
    "better-sqlite3": "latest",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "express": "latest",
    "framer-motion": "latest",
    "geist": "^1.7.2",
    "lenis": "^1.3.26",
    "marked": "latest",
    "multer": "latest",
    "pdfkit": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "styled-components": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/better-sqlite3": "latest",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/pdfkit": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "latest"
  }
}
